{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escierto",
  // La cuenta de Cloudflare del proyecto (escierto.dev@gmail.com), no una personal. Fijarla evita desplegar en otra.
  "account_id": "a59ff336f9e5b7f9bd3182963ba65269",
  "main": "bot/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bluesky no tiene webhooks: se revisan las menciones cada minuto.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // PENDIENTE: escierto.bsky.social es la cuenta de otra persona (creada en 2024, miles de publicaciones).
    // Hay que crear la cuenta propia del bot y poner aquí su handle antes de desplegar.
    "BSKY_HANDLE": "escierto.bsky.social",
    "PUBLIC_URL": "https://escierto.cierto.workers.dev",
    "REPO_URL": "https://github.com/es-cierto/es-cierto",
    // "si" activa /probar, un chat de prueba sin Bluesky. Solo en .dev.vars.
    "PRUEBA_WEB": "no",
  },
  "secrets": {
    "required": ["TAVILY_API_KEY", "BSKY_APP_PASSWORD", "GOOGLE_FACTCHECK_KEY", "CORRECCIONES_TOKEN"],
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "escierto", "database_id": "a1d4a971-1667-4be0-b913-fa0d07139951" },
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "escierto-afirmaciones", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    { "name": "chequeo", "binding": "CHEQUEO", "class_name": "Chequeo" },
    { "name": "correccion", "binding": "CORRECCION", "class_name": "Correccion" },
  ],
}

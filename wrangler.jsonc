{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escierto",
  // Sin account_id a propósito: en local, wrangler usa la cuenta de quien inició sesión (Workers AI y Vectorize corren
  // remotos aun en local, así que cada persona gasta su propio plan). A producción se despliega solo con
  // scripts/desplegar.sh, que exige la cuenta del proyecto.
  "main": "bot/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bluesky no tiene webhooks: se revisan las menciones cada minuto.
  "triggers": { "crons": ["* * * * *"] },
  // La URL pública del bot (escierto.cierto.workers.dev) queda activa; las URLs de vista previa por versión, no:
  // dejarían en línea versiones viejas del bot.
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // La cuenta del bot (creada con escierto.dev@gmail.com). Ojo: escierto.bsky.social, sin guion, es de otra persona.
    "BSKY_HANDLE": "es-cierto.bsky.social",
    "PUBLIC_URL": "https://escierto.cierto.workers.dev",
    "REPO_URL": "https://github.com/es-cierto/es-cierto",
    // "si" activa /probar, un chat de prueba sin Bluesky. Solo en .dev.vars.
    "PRUEBA_WEB": "no",
  },
  "secrets": {
    "required": ["TAVILY_API_KEY", "BSKY_APP_PASSWORD", "GOOGLE_FACTCHECK_KEY", "CORRECCIONES_TOKEN"],
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "escierto", "database_id": "a1d4a971-1667-4be0-b913-fa0d07139951" },
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "escierto-afirmaciones", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    { "name": "chequeo", "binding": "CHEQUEO", "class_name": "Chequeo" },
    { "name": "correccion", "binding": "CORRECCION", "class_name": "Correccion" },
  ],
}

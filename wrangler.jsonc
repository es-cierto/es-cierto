{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escierto",
  "main": "bot/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bluesky no tiene webhooks: se revisan las menciones cada minuto.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // PENDIENTE: escierto.bsky.social es la cuenta de otra persona (creada en 2024, miles de publicaciones).
    // Hay que crear la cuenta propia del bot y poner aquí su handle antes de desplegar.
    "BSKY_HANDLE": "escierto.bsky.social",
    "PUBLIC_URL": "https://escierto.org",
    "REPO_URL": "https://github.com/es-cierto/es-cierto",
    // "si" activa /probar, un chat de prueba sin Bluesky. Solo en .dev.vars.
    "PRUEBA_WEB": "no",
  },
  "secrets": {
    "required": ["TAVILY_API_KEY", "BSKY_APP_PASSWORD", "GOOGLE_FACTCHECK_KEY"],
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "escierto", "database_id": "REEMPLAZAR_CON_wrangler_d1_create" },
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "escierto-afirmaciones", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [{ "name": "chequeo", "binding": "CHEQUEO", "class_name": "Chequeo" }],
}

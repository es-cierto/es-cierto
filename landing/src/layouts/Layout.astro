---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  sinIndice?: boolean;
}

const { titulo, descripcion, sinIndice = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content={sinIndice ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#131209" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!sinIndice && <link rel="canonical" href={canonica} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="¿Es Cierto?" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Un hilo de lino crudo anudado a un documento con sello, al fondo de un fichero de archivo." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenSocial} />
    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip bg-fondo text-papel">
    <a href="#contenido" class="boton boton-principal fixed top-4 left-4 z-[60] -translate-y-24 focus-visible:translate-y-0">
      Saltar al contenido
    </a>
    <Cabecera />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Pie />
    <script>
      import '../scripts/movimiento';
    </script>
  </body>
</html>

---
import { Picture } from 'astro:assets';
import Parada from './Parada.astro';
import Icono from './Icono.astro';
import { cuentaBluesky, ejemplo, enlaces, recorrido } from '../data/sitio';
import inicio from '../assets/recorrido/0-inicio.webp';
import tirar from '../assets/recorrido/1-tirar.webp';
import fuentes from '../assets/recorrido/2-fuentes.webp';
import algoAtado from '../assets/recorrido/3-algo-atado.webp';

// La imagen de cada parada es un cuadro real del video (el primero de su clip; la última, el último del clip C),
// así el clip entra encima sin que se note el cambio.
const imagenes = [inicio, tirar, fuentes, algoAtado];
// Un clip por tramo: el clip k va de la parada k a la k+1.
const clips = ['A', 'B', 'C'];
const titulo = 'mt-4 max-w-xl text-4xl text-balance lg:text-5xl';
const cuerpo = 'mt-4 max-w-md text-lg text-papel/90';
---

<section id="recorrido" data-recorrido aria-label="Cómo funciona, paso a paso" class="relative">
  <div data-escenario class="sticky top-0 h-lvh overflow-hidden bg-fondo" style="--foco: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        imagenes.map((imagen, i) => (
          <div data-cuadro class="absolute inset-0" style={i === 0 ? undefined : 'opacity: 0'}>
            <Picture
              src={imagen}
              alt=""
              formats={['avif', 'webp']} fallbackFormat="webp"
              widths={[828, 1280, 1920]}
              sizes="(min-aspect-ratio: 16/9) 100vw, 178vh"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
              style="object-position: var(--foco) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          clips.map((clip) => (
            <video
              data-clip
              data-webm={`/video/clip-${clip}-1080.webm`}
              data-mp4={`/video/clip-${clip}-1080.mp4`}
              data-movil={`/video/clip-${clip}-720.mp4`}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-fondo/70 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-fondo from-10% via-fondo/50 via-45% to-transparent to-75% lg:bg-linear-to-r lg:from-fondo/90 lg:via-fondo/40 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>

    <nav aria-label="Paradas del recorrido" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-10">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-papel/20">
          <span data-riel class="absolute inset-0 origin-top scale-y-0 bg-lino"></span>
        </span>
        {
          recorrido.map((parada, i) => (
            <li>
              <a href={`#${parada.id}`} data-ir aria-current={i === 0 ? 'true' : 'false'} class="riel group flex h-6 items-center gap-3">
                <span class="rotulo rounded-full bg-fondo/60 px-3 py-1 text-sm whitespace-nowrap ring-1 ring-papel/10 backdrop-blur-xl">
                  {parada.nombre}
                </span>
                <span class="punto size-2 rounded-full bg-papel/50" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p data-pista aria-hidden="true" class="absolute right-10 bottom-8 hidden items-center gap-3 text-sm tracking-wider text-papel/80 uppercase lg:flex">
      Baja para ver cómo funciona
      <span class="pista relative block h-8 w-px overflow-hidden bg-papel/20"></span>
    </p>
    <p class="absolute top-24 right-4 text-[11px] text-papel/50 lg:top-auto lg:right-auto lg:bottom-3 lg:left-12 xl:left-24">Imágenes generadas con IA</p>
  </div>

  <div class="relative z-10 -mt-[100lvh]">
    <Parada indice={0}>
      <h1 class="mt-4">
        <span class="block text-sm font-semibold tracking-wider text-lino uppercase">Verificador de datos para Bluesky</span>
        <span class="mt-4 block max-w-[680px] bg-linear-to-r from-white to-[#9b9b9b] bg-clip-text pb-2 text-4xl text-balance text-transparent lg:text-6xl">
          Te decimos si un dato es cierto, con las&nbsp;fuentes.
        </span>
      </h1>
      <p class={cuerpo}>
        Mencionas al bot en la publicación de Bluesky donde viste el dato. Busca de dónde sale y te responde ahí mismo:
        con las fuentes que lo confirman o lo desmienten, o avisándote que no encontró ninguna.
      </p>
      {
        cuentaBluesky ? (
          <a href={cuentaBluesky.url} class="boton boton-principal mt-6">Menciona a @{cuentaBluesky.handle}</a>
        ) : (
          <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-fondo/60 px-4 py-2 text-sm text-papel ring-1 ring-papel/20 backdrop-blur-md">
            <span aria-hidden="true" class="size-2 rounded-full bg-lino"></span>
            El bot todavía no está activo. Muy pronto en Bluesky.
          </p>
        )
      }
    </Parada>

    <Parada indice={1}>
      <h2 class={titulo}>Mencionas al bot donde viste el&nbsp;dato.</h2>
      <p class={cuerpo}>
        Respondes a la publicación y escribes la cuenta del bot. Él separa el dato que se puede comprobar de las
        opiniones, que no se verifican.
      </p>
    </Parada>

    <Parada indice={2}>
      <h2 class={titulo}>Tira del hilo hasta encontrar de dónde sale el&nbsp;dato.</h2>
      <p class={cuerpo}>
        Revisa leyes, datos oficiales, estudios y verificaciones profesionales. Si con la primera búsqueda no basta,
        vuelve a buscar. Solo usa las fuentes que de verdad encontró.
      </p>
    </Parada>

    <Parada indice={3}>
      <h2 class={titulo}>Si encuentra fuentes, te dice qué tan cierto&nbsp;es.</h2>
      <figure class="mt-6 w-full max-w-md rounded-2xl bg-fondo/70 p-5 ring-1 ring-papel/15 backdrop-blur-md">
        <figcaption class="text-sm font-semibold tracking-wider text-papel/70 uppercase">Así se ve una respuesta</figcaption>
        <p class="mt-3 text-sm text-papel/70">Afirmación revisada</p>
        <blockquote class="mt-1 text-base text-papel">«{ejemplo.afirmacion}»</blockquote>
        <p class="mt-4 flex items-center gap-2 text-xl font-semibold"><Icono nombre={ejemplo.icono} class="size-6 text-lino" /> {ejemplo.veredicto}</p>
        <p class="mt-2 text-base text-papel/90">{ejemplo.resumen}</p>
        <p class="mt-4 text-sm text-papel/70">
          Fuente: <a class="enlace" href={ejemplo.fuente.url} rel="noopener">{ejemplo.fuente.titulo}</a>
        </p>
      </figure>
    </Parada>
  </div>
</section>

<style>
  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluido);
  }

  :global([data-modo='video']) .clips {
    opacity: 1;
  }

  /* Solo se ve el clip del tramo actual; el cambio es instantáneo porque comparten cuadro. */
  .clip {
    object-position: var(--foco) 50%;
    visibility: hidden;
  }

  .clip:global(.visible) {
    visibility: visible;
  }

  .rotulo {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms var(--ease-fluido),
      transform 700ms var(--ease-fluido);
  }

  .riel:hover .rotulo,
  .riel:focus-visible .rotulo,
  .riel[aria-current='true'] .rotulo {
    opacity: 1;
    transform: none;
  }

  .punto {
    transition:
      background-color 700ms var(--ease-fluido),
      transform 700ms var(--ease-fluido);
  }

  .riel[aria-current='true'] .punto {
    background-color: var(--color-lino);
    transform: scale(1.5);
  }

  .pista::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-papel);
    animation: pista 2400ms var(--ease-fluido) infinite;
  }

  @keyframes pista {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista::after { animation: none; }
  }
</style>

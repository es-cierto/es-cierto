---
import Icono from './Icono.astro';
import { escala } from '../data/sitio';
---

<section id="escala" aria-labelledby="titulo-escala" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div data-revelar class="max-w-[680px]">
      <p class="text-sm font-semibold tracking-wider text-lino uppercase">Los veredictos</p>
      <h2 id="titulo-escala" class="mt-4 text-4xl text-balance lg:text-6xl">Cinco respuestas&nbsp;posibles.</h2>
    </div>
    <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {
        escala.map((paso, i) => (
          <li data-revelar style={`transition-delay: ${i * 80}ms`} class="flex flex-col gap-2 rounded-2xl bg-papel/[0.04] p-5 ring-1 ring-papel/10">
            <Icono nombre={paso.icono} class="size-7 text-lino" />
            <h3 class="text-xl">{paso.nombre}</h3>
            <p class="text-base text-papel/80">{paso.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import { preguntas } from '../data/sitio';
---

<section id="preguntas" aria-labelledby="titulo-preguntas" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-3xl">
    <div data-revelar>
      <p class="text-xs font-semibold tracking-widest text-lino uppercase">Preguntas frecuentes</p>
      <h2 id="titulo-preguntas" class="mt-4 text-4xl lg:text-5xl">Lo que conviene saber antes de etiquetarlo.</h2>
    </div>
    <div class="mt-10 divide-y divide-papel/10 border-y border-papel/10">
      {
        preguntas.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium">
              {item.pregunta}
              <span aria-hidden="true" class="text-lino transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-base text-papel/75">
              {item.pendiente && <span class="mr-2 rounded-full bg-lino/15 px-2 py-0.5 text-xs text-lino">Pendiente</span>}
              {item.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

---
import { cuentaBluesky, enlaces, whatsapp } from '../data/sitio';
---

<section aria-labelledby="titulo-cierre" class="px-4 py-32 md:px-12 xl:px-24">
  <div class="mx-auto flex max-w-[680px] flex-col items-center text-center">
    <h2 id="titulo-cierre" data-titular class="text-5xl text-balance lg:text-7xl">¿Viste un dato dudoso?</h2>
    {
      cuentaBluesky ? (
        <>
          <p class="mt-4 text-lg text-papel/80">Responde a la publicación y menciona a @{cuentaBluesky.handle}, o reenvíale el mensaje por WhatsApp al {whatsapp.numero}. El bot busca de dónde sale el dato y te responde ahí mismo.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={cuentaBluesky.url} class="boton boton-principal">Menciona a @{cuentaBluesky.handle}</a>
            <a href={whatsapp.url} class="boton boton-secundario">Escríbele por WhatsApp</a>
          </div>
        </>
      ) : (
        <>
          <p data-revelar class="mt-4 text-xl text-papel/85">Muy pronto podrás mencionar al bot. Parte en Bluesky y después suma otras&nbsp;redes.</p>
          <div data-revelar class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={enlaces.metodologia} class="boton boton-principal">Leer cómo verifica</a>
            <a href={enlaces.repo} class="boton boton-secundario">Seguir en GitHub</a>
          </div>
        </>
      )
    }
  </div>
</section>

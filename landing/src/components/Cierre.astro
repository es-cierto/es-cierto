---
import { cuentaBluesky, enlaces } from '../data/sitio';
---

<section aria-labelledby="titulo-cierre" class="px-4 py-32 md:px-12 xl:px-24">
  <div data-revelar class="mx-auto flex max-w-[680px] flex-col items-center text-center">
    <h2 id="titulo-cierre" class="text-4xl lg:text-6xl">¿Viste un dato dudoso?</h2>
    {
      cuentaBluesky ? (
        <>
          <p class="mt-4 text-lg text-papel/80">Responde a la publicación y etiqueta a @{cuentaBluesky.handle}. Tiramos del hilo por ti.</p>
          <a href={cuentaBluesky.url} class="boton boton-principal mt-8">Etiqueta a @{cuentaBluesky.handle}</a>
        </>
      ) : (
        <>
          <p class="mt-4 text-lg text-papel/80">
            El bot está en preparación. Mientras tanto, puedes revisar cómo trabaja y seguir el proyecto, que es abierto.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={enlaces.repo} class="boton boton-principal">Seguir el proyecto</a>
            <a href={enlaces.metodologia} class="boton boton-secundario">Leer la metodología</a>
          </div>
        </>
      )
    }
  </div>
</section>

---
import { recorrido } from '../data/sitio';



interface Props {
  indice: number;
  
  sinPaso?: boolean;
}

const { indice, sinPaso = false } = Astro.props;
const parada = recorrido[indice];
---

<article id={parada.id} data-parada data-foco={parada.foco} class="parada pointer-events-none flex min-h-[190svh] flex-col justify-end">
  <div class="cuerpo pointer-events-auto sticky bottom-0 flex w-full max-w-2xl xl:max-w-4xl flex-col items-start px-4 pt-32 pb-12 md:px-12 lg:pb-16 xl:px-24">
    {
      !sinPaso && (
        <p class="flex items-center gap-2 text-sm tracking-wider text-papel/75 uppercase">
          <span class="tabular-nums">Paso {indice} de {recorrido.length - 1}</span>
          <span aria-hidden="true" class="size-1 rounded-full bg-lino" />
          <span>{parada.nombre}</span>
        </p>
      )
    }
    <slot />
  </div>
</article>

<style>
  :global(.js) .cuerpo > :global(*) {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms var(--ease-fluido),
      transform 700ms var(--ease-fluido);
  }

  :global(.js) .parada.actual .cuerpo > :global(*),
  :global(.js) .cuerpo:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 1000ms;
  }

  .parada.actual .cuerpo > :global(:nth-child(2)) { transition-delay: 60ms; }
  .parada.actual .cuerpo > :global(:nth-child(3)) { transition-delay: 120ms; }
  .parada.actual .cuerpo > :global(:nth-child(4)) { transition-delay: 180ms; }
  .parada.actual .cuerpo > :global(:nth-child(5)) { transition-delay: 240ms; }

  :global(.js) .parada:not(.actual) .cuerpo:not(:focus-within) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .cuerpo > :global(*) {
      transform: none;
    }
  }
</style>

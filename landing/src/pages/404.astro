---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Página no encontrada · ¿Es Cierto?" descripcion="Esta página no existe." sinIndice>
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-4 text-center">
    <p class="text-xs font-semibold tracking-widest text-lino uppercase">Error 404</p>
    <h1 class="mt-4 text-4xl lg:text-6xl">Tiramos del hilo y aquí no hay nada.</h1>
    <p class="mt-4 max-w-md text-papel/75">La página que buscas no existe o cambió de lugar.</p>
    <a href="/" class="boton boton-principal mt-8">Volver al inicio</a>
  </section>
</Layout>

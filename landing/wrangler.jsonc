{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "es",
  // Sin account_id a propósito: en local, wrangler usa la cuenta de quien inició sesión (Workers AI y Vectorize corren
  // remotos aun en local, así que cada persona gasta su propio plan). A producción se despliega solo con
  // scripts/desplegar.sh, que exige la cuenta del proyecto.
  "compatibility_date": "2026-10-01",
  // Web estática: Workers sirve el build de Astro sin código de Worker, igual que la landing de midudev.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}

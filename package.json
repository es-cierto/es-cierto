{
  "name": "escierto",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "bash scripts/desplegar.sh bot",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'bot/**/*.test.ts' 'perfiles/**/*.test.ts' 'scripts/**/*.test.ts'",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml",
    "eval:ver": "promptfoo view",
    "prepare": "git config core.hooksPath .githooks || true; wrangler types --strict-vars=false >/dev/null",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter escierto-landing typecheck && pnpm --filter escierto-landing test",
    "db:migrar": "wrangler d1 migrations apply escierto",
    "perfiles": "node scripts/perfiles.ts",
    "entorno": "bash scripts/entorno.sh"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "promptfoo": "^0.124.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "pnpm@10.25.0"
}
